{
  "missions": [
    {
      "id": "M01_VOICE",
      "title": {
        "zh": "AI 语音助手",
        "en": "AI Voice Assistant"
      },
      "story": {
        "zh": "把说的话听懂，生成回答，再读出来。",
        "en": "Hear speech, generate a reply, and speak it back."
      },
      "io": {
        "input": {
          "zh": "客户端",
          "en": "Client"
        },
        "output": {
          "zh": "语音回答",
          "en": "Spoken reply"
        }
      },
      "difficulty": "easy",
      "ranked": true,
      "nodes": [
        {
          "node_id": "speech_to_text",
          "service": "TRANSCRIBE",
          "role": {
            "zh": "语音转文字",
            "en": "Speech to text"
          },
          "required": true,
          "depends_on": []
        },
        {
          "node_id": "dialogue_orchestrator",
          "service": "LAMBDA",
          "role": {
            "zh": "对话编排",
            "en": "Dialogue orchestration"
          },
          "required": true,
          "depends_on": [
            "speech_to_text"
          ]
        },
        {
          "node_id": "model_inference",
          "service": "BEDROCK",
          "role": {
            "zh": "模型生成",
            "en": "Model inference"
          },
          "required": true,
          "depends_on": [
            "dialogue_orchestrator"
          ]
        },
        {
          "node_id": "text_to_speech",
          "service": "POLLY",
          "role": {
            "zh": "文字转语音",
            "en": "Text to speech"
          },
          "required": true,
          "depends_on": [
            "model_inference"
          ]
        },
        {
          "node_id": "observe",
          "service": "CLOUDWATCH",
          "role": {
            "zh": "观测",
            "en": "Observability"
          },
          "required": false,
          "depends_on": []
        }
      ],
      "teaching_points": {
        "zh": [
          "客户端接收转写再请求 Lambda；Lambda 分别调用模型和语音合成。",
          "点亮顺序是教学规则，不是云资源部署依赖。"
        ],
        "en": [
          "The client submits the transcript to Lambda, which calls the model and speech synthesis separately.",
          "Activation order is a teaching rule, not cloud deployment dependency."
        ]
      },
      "sources": [
        {
