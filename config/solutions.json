          "url": "https://docs.aws.amazon.com/lambda/latest/dg/urls-auth.html"
        },
        {
          "title": "API_runtime_Converse",
          "url": "https://docs.aws.amazon.com/bedrock/latest/APIReference/API_runtime_Converse.html"
        },
        {
          "title": "API_SynthesizeSpeech",
          "url": "https://docs.aws.amazon.com/polly/latest/APIReference/API_SynthesizeSpeech.html"
        }
      ],
      "scope": {
        "zh": "客户端接收转写再请求 Lambda；Lambda 分别调用模型和语音合成。",
        "en": "The client submits the transcript to Lambda, which calls the model and speech synthesis separately."
      },
