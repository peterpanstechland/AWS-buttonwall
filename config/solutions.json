        }
      },
      "difficulty": "medium",
      "ranked": true,
      "nodes": [
        {
          "node_id": "job_api",
          "service": "API_GATEWAY",
          "role": {
            "zh": "接收请求",
            "en": "Accept the request"
          },
          "required": true,
          "depends_on": []
        },
        {
          "node_id": "producer_lambda",
          "service": "LAMBDA",
          "role": {
            "zh": "写入队列",
            "en": "Enqueue the job"
          },
          "required": true,
          "depends_on": [
            "job_api"
          ]
        },
        {
          "node_id": "job_queue",
          "service": "SQS",
          "role": {
            "zh": "排队",
            "en": "Queue the work"
          },
          "required": true,
          "depends_on": [
            "producer_lambda"
          ]
        },
        {
          "node_id": "worker_lambda",
          "service": "LAMBDA",
          "role": {
            "zh": "取出处理",
            "en": "Dequeue and work"
          },
          "required": true,
          "depends_on": [
            "job_queue"
          ]
        },
        {
          "node_id": "job_table",
          "service": "DYNAMODB",
          "role": {
            "zh": "保存结果",
            "en": "Store the result"
          },
          "required": true,
          "depends_on": [
            "worker_lambda"
          ]
        },
        {
          "node_id": "observe",
          "service": "CLOUDWATCH",
          "role": {
            "zh": "观测",
            "en": "Observability"
